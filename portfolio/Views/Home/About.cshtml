@{
    ViewData["Title"] = "About Me";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <p class="text-uppercase text-muted fw-semibold mb-2">
            About Me
        </p>

        <h1 class="display-5 fw-bold mb-3">
            Get to Know Me
        </h1>

        <p class="text-muted mx-auto"
           style="max-width: 550px;">

            A little information about me, my skills,
            and my journey in Information Technology.

        </p>

    </div>

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="row align-items-center">

                        <div class="col-md-4 text-center mb-4 mb-md-0">

                            <div class="profile-circle shadow">
                                DM
                            </div>

                            <h5 class="fw-bold mt-4 mb-1">
                                Danielle Allyne O. Marcos
                            </h5>

                            <p class="text-muted mb-0">
                                BSIT 31E3
                            </p>

                        </div>


                        <div class="col-md-8">

                            <h3 class="fw-bold mb-3">
                                Hello, I'm Danielle.
                            </h3>

                            <p class="text-muted">
                                I am a Bachelor of Science in Information
                                Technology student who is interested in
                                web development and creating useful
                                applications.
                            </p>

                            <p class="text-muted">
                                Throughout my studies, I have worked on
                                different projects using ASP.NET Core MVC,
                                C#, HTML, CSS, Bootstrap, JavaScript,
                                and database-related technologies.
                            </p>

                            <p class="text-muted mb-4">
                                I created this portfolio to showcase the
                                projects I have developed and the skills
                                I have gained throughout my IT journey.
                            </p>

                            <h5 class="fw-bold mb-3">
                                Technologies I Use
                            </h5>

                            <div class="d-flex flex-wrap gap-2">

                                <span class="badge bg-dark p-2">
                                    ASP.NET Core MVC
                                </span>

                                <span class="badge bg-dark p-2">
                                    C#
                                </span>

                                <span class="badge bg-dark p-2">
                                    HTML
                                </span>

                                <span class="badge bg-dark p-2">
                                    CSS
                                </span>

                                <span class="badge bg-dark p-2">
                                    Bootstrap
                                </span>

                                <span class="badge bg-dark p-2">
                                    JavaScript
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="text-center mt-5">

        <a asp-controller="Projects"
           asp-action="Index"
           class="btn btn-dark px-4 py-3">

            View My Projects

        </a>

    </div>

</div>