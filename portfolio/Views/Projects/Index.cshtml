@model IEnumerable<Portfolio.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <p class="text-uppercase text-muted fw-semibold mb-2">
            My Work
        </p>

        <h1 class="display-5 fw-bold mb-3">
            My Projects
        </h1>

        <p class="text-muted mx-auto"
           style="max-width: 650px;">

            A collection of projects I created throughout my
            Information Technology studies.

        </p>

    </div>


    <div class="card border-0 shadow-sm mb-5">

        <div class="card-body p-4 p-md-5">

            <div class="d-flex align-items-center mb-4">

                <div class="me-3">

                    <span class="badge bg-dark p-2">
                        TOC
                    </span>

                </div>

                <div>

                    <h4 class="fw-bold mb-1">
                        Table of Contents
                    </h4>

                    <p class="text-muted mb-0">
                        Select a project to view its details.
                    </p>

                </div>

            </div>


            <div class="row">

                @foreach (var project in Model)
                {
                    <div class="col-md-6 mb-3">

                        <a asp-controller="Projects"
                           asp-action="Details"
                           asp-route-id="@project.Id"
                           class="text-decoration-none text-dark">

                            <div class="border rounded-3 p-3
                                            d-flex align-items-center">

                                <span class="badge bg-dark me-3">
                                    @project.Id
                                </span>

                                <span class="fw-semibold">
                                    @project.Name
                                </span>

                            </div>

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

    <div class="row g-4">

        @foreach (var project in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card project-card h-100 border-0 shadow-sm">

                    <img src="@project.ImageUrl"
                         class="card-img-top"
                         alt="@project.Name"
                         style="height: 220px; object-fit: cover;" />


                    <div class="card-body p-4 d-flex flex-column">

                        <p class="text-uppercase text-muted
                                      small fw-semibold mb-2">

                            Project @project.Id

                        </p>

                        <h4 class="fw-bold mb-3">
                            @project.Name
                        </h4>

                        <p class="text-muted mb-4">
                            @project.Description
                        </p>


                        <div class="d-flex gap-2 mt-auto">

                            <a asp-controller="Projects"
                               asp-action="Details"
                               asp-route-id="@project.Id"
                               class="btn btn-dark flex-grow-1">

                                View Details

                            </a>

                            <a href="@project.GitHubLink"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-dark">

                                GitHub

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>